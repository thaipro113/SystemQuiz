# ================================================
# SystemQuiz - Environment Configuration
# Copy file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên Git!
# ================================================

# ── Database ─────────────────────────────────────
# SQL Server password (phải có chữ hoa, số, ký tự đặc biệt)
DB_PASSWORD=Quiz@123456!

# Tên database
DB_NAME=QuizDb

# ── JWT Authentication ────────────────────────────
# Key bí mật - THAY ĐỔI khi deploy production!
# Tạo key ngẫu nhiên: openssl rand -base64 32
JWT_KEY=YourSuperSecretKeyHereChangeInProduction!
JWT_ISSUER=QuizAPI
JWT_AUDIENCE=QuizAPIUsers

# ── Frontend ──────────────────────────────────────
# URL của backend API (build time variable)
VITE_API_URL=http://localhost:8080

# ── App Environment ───────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
